# JARVIS secrets template.
# Copy this file to  data/config/.env  and fill in your real key. The real .env is git-ignored and MUST NOT be committed.
#
#   copy .env.example data\config\.env      (Windows)
#
# Gnani speech API key (required for Prisma speech recognition and Timbre speech output).
# Paste the key from your Gnani dashboard here in data/config/.env.
GNANI_API_KEY=
# TypeSafe / JEV reflex-layer API key (optional — without it JARVIS falls back to local UIA/OCR/vision tiers).
# JEV spend is hard-capped at ₹1,000/month by jarvis/jev/budget.py regardless of this key.
TYPESAFE_API_KEY=your-typesafe-jev-key-here
